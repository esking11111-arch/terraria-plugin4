name: Build SignCommands

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '6.0.x'

      - name: Build Project
        run: dotnet build SignCommands/SignCommands.csproj -c Release

      - name: Upload DLL
        uses: actions/upload-artifact@v4
        with:
          name: signcommands-dll
          path: SignCommands/bin/Release/*/SignCommands.dll
